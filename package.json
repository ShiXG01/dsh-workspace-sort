{
  "name": "dsh-workspace-sort",
  "version": "0.1.2",
  "description": "Sort DSH workspaces by their most recent conversation, with workspace pinning.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShiXG01/dsh-workspace-sort.git"
  },
  "homepage": "https://github.com/ShiXG01/dsh-workspace-sort#readme",
  "bugs": {
    "url": "https://github.com/ShiXG01/dsh-workspace-sort/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node build.cjs",
    "test": "node build.cjs && node test/order.test.cjs && node test/menu.test.cjs && node test/controller.test.cjs && node test/ui.test.cjs && node test/host.test.cjs && node test/artifacts.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
